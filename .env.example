# ==========================================
# 3D Listing AI — Local Development
# ==========================================

APP_ENV=local

# The Next.js dev server runs on a second origin only in local development.
ALLOWED_ORIGINS=http://localhost:3000

# ==========================================
# PostgreSQL
# ==========================================

DATABASE_URL=jdbc:postgresql://localhost:5433/listing_ai
DATABASE_USERNAME=listing_ai
DATABASE_PASSWORD=change-me

# ==========================================
# Sessions / Security
# ==========================================

# Local can use false. Production must use true.
SESSION_COOKIE_SECURE=false
SESSION_COOKIE_SAME_SITE=Lax

# ==========================================
# Google OAuth2 (only identity provider — see .ai/decisions/ADR-005-authentication.md)
# ==========================================

# From Google Cloud Console > APIs & Services > Credentials.
# Redirect URI to register there: http://localhost:8080/login/oauth2/code/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Trial allocation for new FREE accounts. Keep low until generation costs are measured.
INITIAL_FREE_CREDITS=1

# ==========================================
# AI
# ==========================================

GEMINI_API_KEY=
AI_MODEL_TEXT=gemini-3.5-flash-lite
AI_LISTING_DAILY_LIMIT=5
# Estimated standard paid-tier USD rates per million tokens; revisit Google's pricing before production.
AI_TEXT_INPUT_USD_PER_MILLION=0.30
AI_TEXT_OUTPUT_USD_PER_MILLION=2.50
AI_MODEL_CREATOR_IMAGE=
AI_MODEL_PRO_IMAGE=
AI_MODEL_FREE_IMAGE=

# ==========================================
# Stripe
# ==========================================

STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_CREATOR_PRICE_ID=
STRIPE_PRO_PRICE_ID=

# ==========================================
# Storage
# ==========================================

# Local uses S3Mock. Production uses R2/S3-compatible storage.
STORAGE_ENDPOINT=http://localhost:9090
STORAGE_BUCKET=listing-ai
STORAGE_ACCESS_KEY=local-s3
STORAGE_SECRET_KEY=local-s3-secret
STORAGE_REGION=us-east-1

# ==========================================
# Optional observability
# ==========================================

LOG_LEVEL=INFO
