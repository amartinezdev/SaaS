# ==========================================
# 3D Listing AI — Local Development
# ==========================================

APP_ENV=local

# Frontend/backend URLs
APP_BASE_URL=http://localhost:8080
FRONTEND_BASE_URL=http://localhost:3000
ALLOWED_ORIGINS=http://localhost:3000

# ==========================================
# PostgreSQL
# ==========================================

DATABASE_URL=jdbc:postgresql://localhost:5432/listing_ai
DATABASE_USERNAME=listing_ai
DATABASE_PASSWORD=change-me

# ==========================================
# Sessions / Security
# ==========================================

# Local can use false. Production must use true.
SESSION_COOKIE_SECURE=false
SESSION_COOKIE_SAME_SITE=Lax

# ==========================================
# Google OAuth2 (only identity provider — see .ai/decisions/ADR-005-authentication.md)
# ==========================================

# From Google Cloud Console > APIs & Services > Credentials.
# Redirect URI to register there: http://localhost:8080/login/oauth2/code/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ==========================================
# AI
# ==========================================

GEMINI_API_KEY=
AI_MODEL_TEXT=
AI_MODEL_CREATOR_IMAGE=
AI_MODEL_PRO_IMAGE=
AI_MODEL_FREE_IMAGE=

# ==========================================
# Stripe
# ==========================================

STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_CREATOR_PRICE_ID=
STRIPE_PRO_PRICE_ID=

# ==========================================
# Storage
# ==========================================

# local = MinIO, production = R2/S3-compatible
STORAGE_PROVIDER=local
STORAGE_ENDPOINT=http://localhost:9000
STORAGE_BUCKET=listing-ai
STORAGE_ACCESS_KEY=minio
STORAGE_SECRET_KEY=change-me-minio

# ==========================================
# Optional observability
# ==========================================

LOG_LEVEL=INFO
